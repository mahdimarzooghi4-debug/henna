{
  "name": "@hana/mobile-consumer",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node ../../tools/mobile/generate-seller-icons.mjs && expo start",
    "android": "node ../../tools/mobile/generate-seller-icons.mjs && expo start --android",
    "typecheck": "tsc --noEmit",
    "export:android": "node ../../tools/mobile/generate-seller-icons.mjs && expo export --platform android --output-dir ../../.expo-export",
    "prepare:android-icon": "node ../../tools/mobile/generate-seller-icons.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/estedad": "^0.4.0",
    "@expo-google-fonts/vazirmatn": "0.4.1",
    "expo": "~57.0.27",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.21",
    "expo-location": "~57.0.23",
    "expo-secure-store": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
