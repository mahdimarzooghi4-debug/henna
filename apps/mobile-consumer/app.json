{
  "expo": {
    "name": "حنا",
    "slug": "hana-consumer",
    "scheme": "hana",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "version": "0.1.0",
    "icon": "./assets/hana-buyer-icon-with-word.png",
    "newArchEnabled": true,
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "برای انتخاب عکس مدرک مشکل سفارش، اجازه دسترسی به عکس انتخاب‌شده را بدهید.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "حنا فقط با اقدام خودتان از موقعیت فعلی برای تکمیل مختصات نشانی استفاده می‌کند."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/hana-buyer-adaptive-foreground.png",
        "backgroundColor": "#FFF2E3"
      }
    },
    "extra": {
      "implementationPhase": "Buyer commerce cold-start recovery, evidence cleanup and foreground address location; SMS/PSP/logistics external integrations pending"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F7F3ED"
    }
  }
}
